# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=3000
SESSION_SECRET=

# --- Database (XAMPP MySQL defaults shown) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=letsconnect

# --- M-Pesa Daraja (sandbox) ---
# Get these free from https://developer.safaricom.co.ke after creating a sandbox app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-deployed-url.example.com/api/payments/callback

# --- Email (Nodemailer) ---
# For Gmail: use an "App Password", not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lets Connect <no-reply@letsconnect.co.ke>"

# --- SMS (Africa's Talking sandbox) ---
AT_USERNAME=sandbox
AT_API_KEY=
